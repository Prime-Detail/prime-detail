---
import BaseLayout from '../layouts/BaseLayout.astro';
import reviewsData from '../data/google-reviews.json';
const base = import.meta.env.BASE_URL;
const reviewCount = typeof reviewsData.userRatingCount === 'number' ? reviewsData.userRatingCount : 0;
const averageRating = typeof reviewsData.rating === 'number' ? reviewsData.rating : null;

const faqItems = [
  {
    q: 'Proposez-vous du detailing a domicile a Deauville ?',
    a: 'Oui, Prime Detail intervient a domicile a Deauville et dans les communes voisines selon disponibilites et type de prestation.'
  },
  {
    q: 'Comment obtenir un devis rapide a Deauville ?',
    a: 'Vous pouvez appeler directement ou envoyer un message WhatsApp avec le modele, l etat du vehicule et la prestation visee.'
  },
  {
    q: 'Le polissage est-il adapte a tous les vehicules ?',
    a: 'Un diagnostic rapide permet de confirmer le niveau de correction pertinent selon l etat de la carrosserie et le rendu souhaite.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Accueil',
      item: `${Astro.site?.toString() || 'https://prime-detail.github.io/prime-detail/'}${base}`
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Detailing autour de Caen',
      item: `${Astro.site?.toString() || 'https://prime-detail.github.io/prime-detail/'}${base}detailing-auto-autour-caen`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Detailing auto a Deauville',
      item: `${Astro.site?.toString() || 'https://prime-detail.github.io/prime-detail/'}${base}detailing-auto-deauville`
    }
  ]
};
---
<BaseLayout
  title="Detailing auto à Deauville : intérieur, polissage, packs premium | Prime Detail"
  description="Detailing auto à Deauville et alentours : nettoyage intérieur premium, polissage carrosserie et packs complets à domicile. Devis personnalisé rapide."
  canonicalPath="detailing-auto-deauville"
>
  <main>
    <section>
      <div class="container">
        <h1>Detailing auto à Deauville avec Prime Detail</h1>
        <p class="section-intro">
          Prime Detail intervient à Deauville pour des prestations de detailing automobile à domicile.
          Objectif : remettre votre véhicule à niveau avec une finition premium et une méthode soignée.
        </p>
      </div>
    </section>

    <section>
      <div class="container">
        <h2>Prestations les plus demandées à Deauville</h2>
        <div class="grid">
          <article class="card">
            <h3>Nettoyage intérieur complet</h3>
            <p>Habitacle, sièges, moquettes, plastiques, vitres intérieures et zones difficiles d’accès.</p>
          </article>
          <article class="card">
            <h3>Polissage carrosserie</h3>
            <p>Correction esthétique, atténuation des défauts visuels légers et protection de la peinture.</p>
          </article>
          <article class="card">
            <h3>Pack intérieur + extérieur</h3>
            <p>Solution globale pour retrouver un véhicule propre, valorisé et agréable à l’usage.</p>
          </article>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2>Pourquoi les clients de Deauville nous choisissent</h2>
        <div class="grid">
          <article class="card">
            <h3>Service adapte au contexte local</h3>
            <p>Intervention a domicile avec organisation claire selon planning, acces et conditions meteo.</p>
          </article>
          <article class="card">
            <h3>Preuves clients verifiables</h3>
            <p>
              {averageRating ? `Note moyenne ${averageRating.toFixed(1)} / 5` : 'Plus de 50 avis clients'}
              {' '}
              et {reviewCount > 0 ? `${reviewCount} avis Google` : 'des retours clients reguliers'}.
            </p>
          </article>
          <article class="card">
            <h3>Devis rapide et structure</h3>
            <p>Estimation claire en 24h avec recommandations selon etat de carrosserie et habitacle.</p>
          </article>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2>Zone d’intervention autour de Deauville</h2>
        <p class="section-intro">
          Interventions possibles à Deauville et communes voisines selon planning, avec déplacement à domicile.
        </p>
        <p>
          Besoin d’une estimation rapide ?
          <a href={`${base}#contact`}>Demandez un devis</a>
          ou consultez les <a href={`${base}#tarifs`}>tarifs indicatifs</a>.
        </p>
        <p>
          Contact direct :
          <span class="local-contact-actions">
            <a href="tel:0656751197" class="local-contact-btn local-contact-call">
              <span class="local-contact-emoji">📞</span> <span>Appeler maintenant</span>
            </a>
            <a href="https://wa.me/33656751197" target="_blank" rel="noopener" class="local-contact-btn local-contact-whatsapp">
              <span class="local-contact-emoji">💬</span> <span>Message WhatsApp</span>
            </a>
          </span>
        </p>
      </div>
    </section>

    <section id="faq-detailing-deauville">
      <div class="container">
        <h2>FAQ - Detailing auto a Deauville</h2>
        <div class="grid">
          {faqItems.map((item) => (
            <article class="card">
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
</BaseLayout>

<style>
  .local-contact-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 10px 0;
    max-width: 320px;
  }

  .local-contact-btn {
    color: #fff;
    font-size: 1.08em;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 0;
    border-radius: 12px;
    text-decoration: none;
  }

  .local-contact-call {
    background: #1fa363;
    box-shadow: 0 2px 8px #1fa36333;
  }

  .local-contact-whatsapp {
    background: #25d366;
    box-shadow: 0 2px 8px #25d36633;
  }

  .local-contact-emoji {
    font-size: 1.18em;
  }
</style>
