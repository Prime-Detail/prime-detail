---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCAL_CITY_PAGES } from '../../data/local-cities';
import reviewsData from '../../data/google-reviews.json';

export function getStaticPaths() {
  return LOCAL_CITY_PAGES.map((city) => ({
    params: { ville: city.slug },
    props: {
      cityName: city.name,
      citySlug: city.slug,
      accessHint: city.accessHint,
      parkingHint: city.parkingHint,
      nearbySpots: city.nearbySpots
    }
  }));
}

const {
  cityName,
  citySlug,
  accessHint,
  parkingHint,
  nearbySpots
} = Astro.props as {
  cityName: string;
  citySlug: string;
  accessHint: string;
  parkingHint: string;
  nearbySpots: string;
};
const base = import.meta.env.BASE_URL;

const cityIndex = LOCAL_CITY_PAGES.findIndex((city) => city.slug === citySlug);
const relatedCities = LOCAL_CITY_PAGES
  .filter((city) => city.slug !== citySlug)
  .slice(Math.max(0, cityIndex - 1), Math.max(0, cityIndex - 1) + 3);
const reviewCount = typeof reviewsData.userRatingCount === 'number' ? reviewsData.userRatingCount : 0;
const averageRating = typeof reviewsData.rating === 'number' ? reviewsData.rating : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Accueil',
      item: `${Astro.site?.toString() || 'https://prime-detail.github.io/prime-detail/'}${base}`
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Detailing autour de Caen',
      item: `${Astro.site?.toString() || 'https://prime-detail.github.io/prime-detail/'}${base}detailing-auto-autour-caen`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `Detailing auto a ${cityName}`,
      item: `${Astro.site?.toString() || 'https://prime-detail.github.io/prime-detail/'}${base}detailing-auto/${citySlug}`
    }
  ]
};

const faqItems = [
  {
    q: `Intervenez-vous a domicile a ${cityName} ?`,
    a: `Oui, Prime Detail intervient a domicile a ${cityName} et dans les communes voisines selon disponibilites et planning.`
  },
  {
    q: `Quel delai pour recevoir un devis a ${cityName} ?`,
    a: `Un devis est generalement propose sous 24h apres analyse des informations du vehicule. ${accessHint}`
  },
  {
    q: `Quel est le meilleur format d intervention a ${cityName} ?`,
    a: `Le nettoyage interieur seul est adapte si l habitacle est prioritaire. Le pack complet est preferable pour valoriser interieur et exterieur ensemble. ${parkingHint}`
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};
---
<BaseLayout
  title={`Detailing auto à ${cityName} : intérieur, polissage, packs premium | Prime Detail`}
  description={`Detailing auto à ${cityName} et autour de Caen : nettoyage intérieur, polissage carrosserie et packs premium à domicile. Devis rapide avec Prime Detail.`}
  canonicalPath={`detailing-auto/${citySlug}`}
>
  <main>
    <section>
      <div class="container">
        <h1>Detailing auto à {cityName} avec Prime Detail</h1>
        <p class="section-intro">
          Prime Detail intervient à {cityName} pour des prestations de detailing automobile à domicile,
          avec une méthode rigoureuse et une finition premium.
        </p>
        <p>
          Secteurs proches souvent couverts lors des mêmes tournées : <strong>{nearbySpots}</strong>.
        </p>
      </div>
    </section>

    <section>
      <div class="container">
        <h2>Prestations disponibles à {cityName}</h2>
        <div class="grid">
          <article class="card">
            <h3>Nettoyage intérieur complet</h3>
            <p>Habitacle, sièges, moquettes, plastiques, vitres intérieures et zones difficiles d’accès.</p>
          </article>
          <article class="card">
            <h3>Polissage carrosserie</h3>
            <p>Correction esthétique, atténuation des défauts visuels légers et protection de la peinture.</p>
          </article>
          <article class="card">
            <h3>Pack intérieur + extérieur</h3>
            <p>Solution globale pour retrouver un véhicule propre, valorisé et agréable à l’usage.</p>
          </article>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2>Contexte local à {cityName}</h2>
        <div class="grid">
          <article class="card">
            <h3>Organisation des interventions</h3>
            <p>{accessHint}</p>
          </article>
          <article class="card">
            <h3>Conseil stationnement</h3>
            <p>{parkingHint}</p>
          </article>
          <article class="card">
            <h3>Communes proches</h3>
            <p>{nearbySpots}</p>
          </article>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2>Pourquoi les clients de {cityName} nous choisissent</h2>
        <div class="grid">
          <article class="card">
            <h3>Detailer specialise local</h3>
            <p>Intervention a domicile avec methode stable, controle final et conseils d entretien apres prestation.</p>
          </article>
          <article class="card">
            <h3>Preuves clients verifiables</h3>
            <p>
              {averageRating ? `Note moyenne ${averageRating.toFixed(1)} / 5` : 'Plus de 50 avis clients'}
              {' '}
              et {reviewCount > 0 ? `${reviewCount} avis Google` : 'des retours clients reguliers'}.
            </p>
          </article>
          <article class="card">
            <h3>Devis clair en 24h</h3>
            <p>Reponse rapide avec options adaptees au vehicule, sans proposition vague ni survente inutile.</p>
          </article>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2>Intervention autour de {cityName}</h2>
        <p class="section-intro">
          Déplacements possibles dans {cityName} et les communes voisines (zone ~20 km autour de Caen) selon planning.
        </p>
        <p>
          Besoin d’une estimation rapide ?
          <a href={`${base}#contact`}>Demandez un devis gratuit</a>
          ou consultez les <a href={`${base}#tarifs`}>tarifs indicatifs</a>.
        </p>
        <p>
          Contact direct :
          <span class="local-contact-actions">
            <a href="tel:0656751197" class="local-contact-btn local-contact-call">
              <span class="local-contact-emoji">📞</span> <span>Appeler maintenant</span>
            </a>
            <a href="https://wa.me/33656751197" target="_blank" rel="noopener" class="local-contact-btn local-contact-whatsapp">
              <span class="local-contact-emoji">💬</span> <span>Message WhatsApp</span>
            </a>
          </span>
        </p>
        <p>
          Voir aussi:
          <a href={`${base}detailing-auto-autour-caen`}>Toutes les villes desservies autour de Caen (20 km)</a>.
        </p>

        {relatedCities.length > 0 ? (
          <div>
            <p>Pages voisines utiles :</p>
            <ul>
              {relatedCities.map((city) => (
                <li><a href={`${base}detailing-auto/${city.slug}`}>Detailing auto à {city.name}</a></li>
              ))}
            </ul>
          </div>
        ) : null}
      </div>
    </section>

    <section id="faq-detailing-local">
      <div class="container">
        <h2>FAQ - Detailing auto a {cityName}</h2>
        <div class="grid">
          {faqItems.map((item) => (
            <article class="card">
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
</BaseLayout>

<style>
  .local-contact-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 10px 0;
    max-width: 320px;
  }

  .local-contact-btn {
    color: #fff;
    font-size: 1.08em;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 0;
    border-radius: 12px;
    text-decoration: none;
  }

  .local-contact-call {
    background: #1fa363;
    box-shadow: 0 2px 8px #1fa36333;
  }

  .local-contact-whatsapp {
    background: #25d366;
    box-shadow: 0 2px 8px #25d36633;
  }

  .local-contact-emoji {
    font-size: 1.18em;
  }
</style>
