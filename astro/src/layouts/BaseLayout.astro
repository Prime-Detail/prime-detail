---
import { AREA_SERVED_CITIES } from '../data/local-cities';
import reviewsData from '../data/google-reviews.json';
import path from 'node:path';

const GA_MEASUREMENT_ID = 'G-FJBK0MCYPQ';
const META_PIXEL_ID = '1189334119528421';
const META_CAPI_ENDPOINT = import.meta.env.PUBLIC_META_CAPI_ENDPOINT || '';
const base = import.meta.env.BASE_URL;
// Utilise uniquement le CSS du projet (styles.css) comme fallback
import fs from 'node:fs';
const cssPath = path.resolve(process.cwd(), '..', 'styles.css');
let siteCss = '';
try {
  siteCss = fs.readFileSync(cssPath, 'utf-8');
} catch (e) {
  siteCss = '';
}

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  ogImagePath?: string;
  noindex?: boolean;
}

const {
  title = 'Prime Detail – Detailing Auto Premium à Domicile | Caen',
  description = 'Detailing intérieur et rénovation carrosserie à domicile autour de Caen. Detailer certifié FD Formation. Nettoyage intérieur complet, polissage et packs premium.',
  canonicalPath,
  ogType = 'website',
  ogImagePath = 'assets/images/gallery/apres.jpeg',
  noindex = false
} = Astro.props as Props;

const fallbackSite = new URL('https://prime-detail.github.io/prime-detail/');
const siteUrl = Astro.site ? new URL(Astro.site.toString()) : fallbackSite;

function absoluteUrl(relativeOrPath: string) {
  return new URL(relativeOrPath.replace(/^\//, ''), siteUrl).toString();
}

const canonicalUrl = canonicalPath ? absoluteUrl(canonicalPath) : (Astro.url?.href || siteUrl.toString());
const ogImageUrl = absoluteUrl(ogImagePath);
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow';
const hasAggregateRating = typeof reviewsData.rating === 'number' && typeof reviewsData.userRatingCount === 'number' && reviewsData.userRatingCount > 0;

const serviceDefinitions = [
  {
    id: 'service-interieur',
    name: 'Nettoyage interieur automobile',
    description: 'Remise a niveau complete de l habitacle : sieges, moquettes, plastiques, vitres interieures et zones difficiles d acces.'
  },
  {
    id: 'service-polissage',
    name: 'Polissage carrosserie',
    description: 'Correction esthetique de la carrosserie avec attenuation des defauts visuels legers et protection adaptee.'
  },
  {
    id: 'service-pack',
    name: 'Pack detailing interieur + exterieur',
    description: 'Prestation complete interieur et exterieur pour valoriser le vehicule dans son ensemble.'
  }
];

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl.toString()}#organization`,
      name: 'Prime Detail',
      url: siteUrl.toString(),
      logo: absoluteUrl('assets/images/logo/logo2.png'),
      email: 'primedetailcaen@gmail.com',
      telephone: '+33656751197',
      sameAs: [
        'https://wa.me/33656751197',
        reviewsData.googleMapsUri || siteUrl.toString()
      ]
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.toString()}#website`,
      url: siteUrl.toString(),
      name: 'Prime Detail',
      publisher: { '@id': `${siteUrl.toString()}#organization` },
      inLanguage: 'fr-FR'
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'fr-FR',
      isPartOf: { '@id': `${siteUrl.toString()}#website` },
      about: { '@id': `${siteUrl.toString()}#localbusiness` }
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${siteUrl.toString()}#localbusiness`,
      name: 'Prime Detail',
      url: siteUrl.toString(),
      parentOrganization: { '@id': `${siteUrl.toString()}#organization` },
      image: ogImageUrl,
      telephone: '+33656751197',
      email: 'primedetailcaen@gmail.com',
      priceRange: '€€',
      hasMap: reviewsData.googleMapsUri || undefined,
      serviceArea: AREA_SERVED_CITIES.map((city) => ({ '@type': 'City', name: city })),
      areaServed: AREA_SERVED_CITIES.map((city) => ({ '@type': 'City', name: city })),
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Caen',
        addressRegion: 'Normandie',
        addressCountry: 'FR'
      },
      sameAs: [
        'https://wa.me/33656751197',
        reviewsData.googleMapsUri || siteUrl.toString()
      ],
      ...(hasAggregateRating
        ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: reviewsData.rating,
              reviewCount: reviewsData.userRatingCount
            }
          }
        : {}),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Prestations detailing',
        itemListElement: serviceDefinitions.map((service, index) => ({
          '@type': 'Offer',
          position: index + 1,
          itemOffered: { '@id': `${siteUrl.toString()}#${service.id}` }
        }))
      }
    },
    ...serviceDefinitions.map((service) => ({
      '@type': 'Service',
      '@id': `${siteUrl.toString()}#${service.id}`,
      name: service.name,
      description: service.description,
      provider: { '@id': `${siteUrl.toString()}#localbusiness` },
      areaServed: AREA_SERVED_CITIES.map((city) => ({ '@type': 'City', name: city }))
    }))
  ]
};
---
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robotsContent} />
    <meta name="google-site-verification" content="google66b58e4d504a4285" />

    <meta name="theme-color" content="#1e5f71" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}assets/images/logo/logo2.png`} />
    <link rel="shortcut icon" href={`${base}assets/images/logo/logo2.png`} />
    <link rel="apple-touch-icon" href={`${base}assets/images/logo/logo2.png`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline define:vars={{ base }}>
      window.__BASE_URL__ = base;
    </script>

    <script is:inline define:vars={{ GA_MEASUREMENT_ID, META_PIXEL_ID, META_CAPI_ENDPOINT }}>
      window.__PD_TRACKING_CONFIG__ = {
        gaMeasurementId: GA_MEASUREMENT_ID,
        metaPixelId: META_PIXEL_ID,
        metaCapiEndpoint: META_CAPI_ENDPOINT
      };
      window.__META_CAPI_ENDPOINT__ = META_CAPI_ENDPOINT;
    </script>
    <script is:inline>
      window.__metaCapiSend = function (eventData) {
        var endpoint = window.__META_CAPI_ENDPOINT__ || '';
        if (!endpoint || !eventData) {
          return;
        }

        var payload = {
          event_name: eventData.eventName,
          standard_event_name: eventData.standardEventName || '',
          event_id: eventData.eventId || '',
          event_source_url: window.location.href,
          event_time: Math.floor(Date.now() / 1000),
          custom_data: eventData.payload || {}
        };

        try {
          if (typeof navigator !== 'undefined' && typeof navigator.sendBeacon === 'function') {
            var blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
            if (navigator.sendBeacon(endpoint, blob)) {
              return;
            }
          }
        } catch (error) {
        }

        try {
          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            keepalive: true
          });
        } catch (error) {
        }
      };
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet" />
    <style set:html={siteCss}></style>
    <style>
      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      @media (max-width: 640px) {
        body {
          font-size: 1rem;
        }

        h1 {
          font-size: clamp(2rem, 8vw, 2.6rem) !important;
          line-height: 1.15;
        }
      }
    </style>
  </head>
  <body>
    <slot />
    <div class="global-mobile-contact-bar" aria-label="Actions de contact rapides">
      <a
        id="global-mobile-call"
        class="global-mobile-contact-btn call"
        href="tel:0656751197"
        aria-label="Appeler Prime Detail"
        style="background: #1fa363; color: #fff; font-size: 1.08em; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 0; border-radius: 12px; box-shadow: 0 2px 8px #1fa36333;"
      >
        <span style="font-size:1.18em;">📞</span> <span>Appeler maintenant</span>
      </a>
      <a
        id="global-mobile-whatsapp"
        class="global-mobile-contact-btn whatsapp"
        href="https://wa.me/33656751197"
        target="_blank"
        rel="noopener"
        aria-label="Envoyer un message WhatsApp a Prime Detail"
        style="background: #25d366; color: #fff; font-size: 1.08em; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 0; border-radius: 12px; box-shadow: 0 2px 8px #25d36633; margin-top: 8px;"
      >
        <span style="font-size:1.18em;">💬</span> <span>Message WhatsApp</span>
      </a>
    </div>
    <script src={`${base}scripts/global-contact-bar.js`} defer></script>
    <script src={`${base}scripts/consent-manager.js`} defer></script>
  </body>
</html>
